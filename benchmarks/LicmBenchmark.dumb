function _test(param)
{
    variable ind = param;
    variable result = 0;
    while ( ind < 1000 )
    {
        variable inv = param * 10 + param * param * param;
        result = result * inv;
        ind = ind + 1;
    }
}

function main()
{
    variable result = _test(10);
    output(result, "Result = ");
    return 0;
}
