function fib(num)
{
    if ( num == 0 )
    {
        return 0;
    }
    if ( num == 1 )
    {
        return 1;
    }
    return fib(num - 1) + fib(num - 2);
}

function main()
{
    variable num = 10;

    variable counter = 10000000;
    variable result = 0;
    while ( counter > 0 )
    {
        result = result + fib(num);
        counter = counter - 1;
    }
    output(result, "Result = ");
}
