function fib(num)
{
    if ( num == 0 )
    {
        return 0;
    }
    if ( num == 1 )
    {
        return 1;
    }

    return fib( num - 1) + fib( num - 2);
}

function _test(num)
{
    return fib( num);
}

function main()
{
    variable result = _test(35);
    output(result, "Result = ");
    return 0;
}
