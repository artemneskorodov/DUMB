function _test(parameter)
{
    variable a = parameter + 10;
    variable b = a + 5;
    variable c = b * 2;
    variable d = c * 120;
    variable e = d / 30;
    variable f = e * 35;
    variable g = f / 5;
    variable h = g / 7;

    variable x1 = c + 100;
    variable x2 = d * 2;
    variable x3 = c * 100;
    variable x4 = h * 700;
    variable x5 = f * 10;
    variable x6 = h + 25;

    return h;
}

function main()
{
    variable result = _test(10);
    output(result, "Result = ");
    return 0;
}
