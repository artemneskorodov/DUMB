function fib(num)
{
    if ( num == 0 )
    {
        return 0;
    }
    if ( num == 1 )
    {
        return 1;
    }
    return fib(num - 1) + fib(num - 2);
}

function main()
{
    variable num = 0;
    input(num, "Num = ");

    variable result = fib(num);

    output(result, "Fib(num) = ");
}
