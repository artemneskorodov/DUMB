    variable x9 = 10; if ( x9 > 0 ) { a9 = 1; } if ( x9 < 0 ) { a9 = 2; }

    return x0 + x1 + x2 + x3 + x4 + x5 + x6 + x7 + x8 + x9;
}

function main()
{
