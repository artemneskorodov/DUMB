    variable x3 = 10; if ( x3 > 0 ) { a3 = 1; } if ( x3 < 0 ) { a3 = 2; }
    variable x4 = 10; if ( x4 > 0 ) { a4 = 1; } if ( x4 < 0 ) { a4 = 2; }
    variable x5 = 10; if ( x5 > 0 ) { a5 = 1; } if ( x5 < 0 ) { a5 = 2; }
