    variable x0 = 10; if ( x0 > 0 ) { a0 = 1; } if ( x0 < 0 ) { a0 = 2; }
    variable x1 = 10; if ( x1 > 0 ) { a1 = 1; } if ( x1 < 0 ) { a1 = 2; }
